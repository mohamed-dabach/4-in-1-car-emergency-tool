# Firestore: الطلبات كيتسجلو هنا الأول، و Apps Script ديال الشيت كيجبدهم كل دقيقة.
# الـ API key ديال Firebase Web عادي يكون عمومي؛ الحماية كاينة ف firestore.rules.
VITE_FIREBASE_PROJECT_ID="caryystore-orders-7854"
VITE_FIREBASE_API_KEY="AIzaSy..."

# احتياط: URL ديال Google Apps Script Web App، كيتستعمل غير إلا Firestore طاح.
# شوف scripts/orders-apps-script.gs باش تعرف كيفاش تركبو.
# حطها ف Vercel: Settings → Environment Variables (Production + Preview)
VITE_ORDERS_WEBHOOK="https://script.google.com/macros/s/XXXXXXXX/exec?key=YOUR_SECRET"

# Meta (Facebook) Pixel ID — كيخدم مع src/lib/metaEvents.ts (advanced matching).
# الـ ID فوقاني حاط ديجا مباشرة فـ index.html (باش يبان لـ Meta Pixel Helper
# من أول تحميل للصفحة). بدّل هنا وف index.html بزوج إلا غيّرتي الـ pixel.
VITE_FB_PIXEL_ID="1405464681543137"

# Microsoft Clarity project ID (heatmaps + session recordings).
# بحال الـ pixel: الـ ID حاط ديجا مباشرة فـ index.html حيت السكريبت خاصو
# يخدم من أول تحميل. بدّل هنا وف index.html بزوج إلا غيّرتي المشروع.
VITE_CLARITY_ID="yha9qxll4o"
